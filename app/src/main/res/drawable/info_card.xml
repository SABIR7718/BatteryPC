<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:top="4dp"
        android:left="1dp"
        android:right="1dp">

        <shape android:shape="rectangle">

            <corners android:radius="16dp" />

            <gradient
                android:angle="270"
                android:startColor="#151E18"
                android:endColor="#090E0B" />

            <stroke
                android:width="1dp"
                android:color="#203B27" />

        </shape>

    </item>

</layer-list>