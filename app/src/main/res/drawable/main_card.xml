<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:top="5dp"
        android:left="2dp"
        android:right="2dp">

        <shape android:shape="rectangle">

            <corners android:radius="20dp" />

            <gradient
                android:angle="270"
                android:startColor="#18221B"
                android:centerColor="#101712"
                android:endColor="#080C09" />

            <stroke
                android:width="1dp"
                android:color="#28452D" />

        </shape>

    </item>

</layer-list>