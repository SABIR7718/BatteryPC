<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050807">

    <!-- MAIN UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- TOP APP ICON -->
        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="18dp"
            android:padding="7dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:elevation="14dp"
            android:contentDescription="App Icon" />

        <!-- APP NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="BATTERYPC"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:shadowColor="#65FF00"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="BATTERY CONTROL ENGINE"
            android:textColor="#65FF00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:shadowColor="#65FF00"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5" />

        <!-- STATUS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:elevation="8dp"
            android:background="@drawable/status_bg">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="Status: Checking Shizuku..."
                android:textColor="#B8FF8A"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MAIN CONTROL CARD -->
        <LinearLayout
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="14dp"
            android:translationZ="5dp"
            android:background="@drawable/main_card">

            <!-- CARD TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATTERY CONTROL"
                android:textColor="#F1FEFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="5" />

            <!-- CURRENT SELECTION -->
            <TextView
                android:id="@+id/tvBatteryVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="15dp"
                android:text="Battery: 50%"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="5" />

            <!-- SLIDER -->
            <SeekBar
                android:id="@+id/sbBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="25dp"
                android:max="100"
                android:progress="50"
                android:progressTint="#65FF00"
                android:thumbTint="#65FF00" />

            <!-- CUSTOM LEVEL LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM BATTERY LEVEL"
                android:textColor="#8D9990"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- INPUT -->
            <EditText
                android:id="@+id/etCustomBattery"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="9dp"
                android:hint="Enter level 1 - 9999"
                android:textColorHint="#4F5B52"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:maxLength="4"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:elevation="5dp"
                android:background="@drawable/input_bg" />

            <!-- BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- SET + RESET -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSet"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="SET BATTERY"
                        android:textColor="#061006"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:elevation="10dp"
                        android:stateListAnimator="@anim/button_press"
                        android:background="@drawable/set_button" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btnReset"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="RESET"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:elevation="10dp"
                        android:stateListAnimator="@anim/button_press"
                        android:background="@drawable/reset_button" />

                </LinearLayout>

                <!-- CHARGING -->
                <Button
                    android:id="@+id/btnCharging"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="CHARGING OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:elevation="10dp"
                    android:stateListAnimator="@anim/button_press"
                    android:background="@drawable/charging_button" />

            </LinearLayout>

        </LinearLayout>

        <!-- SHIZUKU POWERED -->
        <LinearLayout
            android:id="@+id/infoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="15dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:elevation="10dp"
            android:translationZ="3dp"
            android:background="@drawable/info_card">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/shizuku_logo"
                android:scaleType="fitCenter"
                android:elevation="5dp"
                android:contentDescription="Shizuku Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHIZUKU POWERED"
                    android:textColor="#F1FEFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Privileged shell access via Shizuku"
                    android:textColor="#727C74"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

